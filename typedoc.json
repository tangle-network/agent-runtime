{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/agent/index.ts",
    "src/durable/index.ts",
    "src/durable/chat-turn.ts",
    "src/tool-loop.ts",
    "src/placement/index.ts",
    "src/intelligence/index.ts",
    "src/runtime/index.ts",
    "src/analyst-loop/index.ts",
    "src/profiles/index.ts",
    "src/platform/index.ts",
    "src/candidate-execution/index.ts",
    "src/testing/index.ts",
    "src/mcp/index.ts",
    "src/tui/index.ts",
    "src/runtime/task-queue.ts",
    "src/workspace-store/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "./tsconfig.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "docs/api",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/tests/**",
    "**/examples/**",
    "src/mcp/bin.ts",
    "src/loop-runner-bin.ts",
    "src/tui/bin.ts"
  ],
  "disableSources": true,
  "hideGenerator": true,
  "skipErrorChecking": true,
  "sort": [
    "source-order"
  ],
  "githubPages": false,
  "outputFileStrategy": "modules",
  "externalSymbolLinkMappings": {
    "@tangle-network/agent-runtime": {
      "RouteFlow": "https://github.com/tangle-network/agent-runtime/blob/main/src/mcp/tools/coordination-route-contracts.ts",
      "DecideGate": "https://github.com/tangle-network/agent-runtime/blob/main/src/mcp/tools/coordination-route-contracts.ts",
      "RouteSpawnMarker": "https://github.com/tangle-network/agent-runtime/blob/main/src/mcp/tools/coordination-route-contracts.ts",
      "GateDecisionRecord": "https://github.com/tangle-network/agent-runtime/blob/main/src/mcp/tools/coordination-route-contracts.ts",
      "RouteFlowEvent": "https://github.com/tangle-network/agent-runtime/blob/main/src/mcp/tools/coordination-route-contracts.ts"
    }
  }
}
