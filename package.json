{
  "name": "@tangle-network/agent-runtime",
  "version": "0.5.4",
  "description": "Reusable runtime lifecycle for domain-specific agents.",
  "homepage": "https://github.com/tangle-network/agent-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/agent-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tangle-network/agent-eval": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
