{
  "name": "@tangle-network/agent-runtime",
  "version": "0.340.0",
  "description": "Shared task-lifecycle skeleton for agents: a recursive loop kernel for chat turns, one-shot tasks, and multi-attempt loops, with trace capture and eval-gated self-improvement. Domain behavior lives in adapters; scoring and ship-gates in @tangle-network/agent-eval.",
  "homepage": "https://github.com/tangle-network/agent-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/agent-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js",
      "default": "./dist/durable.js"
    },
    "./tool-loop": {
      "types": "./dist/tool-loop.d.ts",
      "import": "./dist/tool-loop.js",
      "default": "./dist/tool-loop.js"
    },
    "./placement": {
      "types": "./dist/placement.d.ts",
      "import": "./dist/placement.js",
      "default": "./dist/placement.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence.d.ts",
      "import": "./dist/intelligence.js",
      "default": "./dist/intelligence.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js",
      "default": "./dist/kernel.js"
    },
    "./analyst-loop": {
      "types": "./dist/analyst-loop.d.ts",
      "import": "./dist/analyst-loop.js",
      "default": "./dist/analyst-loop.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js",
      "default": "./dist/profiles.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js",
      "default": "./dist/platform.js"
    },
    "./candidate-execution": {
      "types": "./dist/candidate-execution/index.d.ts",
      "import": "./dist/candidate-execution/index.js",
      "default": "./dist/candidate-execution/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js",
      "default": "./dist/tui/index.js"
    },
    "./task-queue": {
      "types": "./dist/task-queue.d.ts",
      "import": "./dist/task-queue.js",
      "default": "./dist/task-queue.js"
    },
    "./workspace-store": {
      "types": "./dist/workspace-store/index.d.ts",
      "import": "./dist/workspace-store/index.js",
      "default": "./dist/workspace-store/index.js"
    }
  },
  "bin": {
    "agent-runtime-mcp": "./dist/mcp/bin.js",
    "agent-runtime-memory-mcp": "./dist/mcp/memory-bin.js",
    "agent-runtime-loop": "./dist/loop-runner-bin.js",
    "agent-runtime-top": "./dist/tui/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests examples",
    "lint:fix": "biome check --write src tests examples",
    "typecheck": "tsc --noEmit && pnpm run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "generate:testing-fixture": "node --import tsx scripts/generate-agent-improvement-proposal-fixtures.ts",
    "check:testing-fixture": "node --import tsx scripts/generate-agent-improvement-proposal-fixtures.ts --check",
    "check:skills": "node scripts/check-skills.mjs",
    "conformance:durability": "node scripts/run-durability-conformance.mjs",
    "conformance:capacity": "vitest run scripts/full-capacity-acceptance.test.mjs scripts/full-capacity-collector.test.mjs",
    "check:model-execution-boundary": "node scripts/check-model-execution-boundary.mjs",
    "check:publish-workflow": "node scripts/check-publish-workflow.mjs",
    "check:upstream-evidence-workflow": "node scripts/check-upstream-evidence-workflow.mjs",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "check:release-notes": "node scripts/release-notes.mjs",
    "check:api-surface": "node scripts/check-api-surface.mjs",
    "check:api-surface-record": "node scripts/check-api-surface.mjs --record",
    "api:surface": "node scripts/check-api-surface.mjs --write",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "verify:static-imports": "node scripts/verify-static-imports.mjs",
    "verify:edge-tool-loop": "node scripts/verify-edge-tool-loop.mjs",
    "verify:bench": "pnpm build && pnpm --filter @tangle-network/agent-bench run typecheck:public && pnpm --filter @tangle-network/agent-bench test && pnpm --filter @tangle-network/agent-bench run verify:package:local-runtime",
    "verify:bench:source": "pnpm build && pnpm --filter @tangle-network/agent-bench run typecheck:public && pnpm --filter @tangle-network/agent-bench test && pnpm --filter @tangle-network/agent-bench run verify:package:static",
    "verify:bench:published": "pnpm run verify:bench:source && pnpm --filter @tangle-network/agent-bench exec node scripts/verify-packed-consumer.mjs",
    "verify:cohort": "node scripts/verify-packed-cohort.mjs",
    "verify:package": "pnpm run verify:package:static && node scripts/verify-package-exports.mjs && pnpm run verify:edge-tool-loop",
    "verify:package:static": "pnpm run check:model-execution-boundary && pnpm run verify:static-imports && pnpm run build && pnpm run check:api-surface && pnpm run check:testing-fixture && pnpm run check:skills && publint && attw --pack --profile esm-only .",
    "verify:official-optimizers": "node scripts/verify-official-optimizers.mjs",
    "docs:api": "pnpm run build && typedoc && node scripts/generated-api-links.mjs --write && node scripts/gen-primitive-catalog.mjs",
    "docs:freshness": "node scripts/check-docs-freshness.mjs",
    "docs:check": "pnpm run docs:api && git diff --exit-code -- docs/api && pnpm run docs:freshness"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/sdk": "catalog:",
    "@tangle-network/agent-eval": "0.217.1",
    "@tangle-network/agent-interface": "5.7.0",
    "@tangle-network/agent-provider-cli-bridge": "2.0.1",
    "@tangle-network/agent-provider-daytona": "0.6.0",
    "@tangle-network/agent-provider-e2b": "0.6.0",
    "@tangle-network/agent-provider-tangle": "4.4.6",
    "@tangle-network/sandbox": "0.63.24",
    "@types/node": "catalog:",
    "@types/tar-stream": "3.1.4",
    "miniflare": "4.20260722.0",
    "oxc-parser": "0.147.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "catalog:",
    "typescript-consumer": "npm:typescript@7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "peerDependencies": {
    "@tangle-network/agent-eval": ">=0.215.0 <0.218.0",
    "@tangle-network/agent-interface": ">=5.7.0 <6.0.0",
    "@tangle-network/sandbox": ">=0.61.1 <0.61.2 || >=0.62.2 <0.62.3 || >=0.62.14 <0.62.16 || >=0.63.10 <0.64.0"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.0.4",
    "@tangle-network/agent-core": ">=0.12.0 <0.13.0",
    "@tangle-network/agent-knowledge": "^22.0.7",
    "@tangle-network/agent-profile-materialize": ">=0.25.2 <0.28.0",
    "@tangle-network/agent-trace-contract": "catalog:",
    "tar-stream": "3.2.1",
    "zod": "catalog:"
  }
}
