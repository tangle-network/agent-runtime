{
  "name": "@tangle-network/agent-runtime-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "External-benchmark harness for the agent-runtime loop: run blind vs steering vs steering+memory drivers against real benchmarks (SWE-bench, Terminal-Bench, AppWorld) and their DETERMINISTIC judges.",
  "scripts": {
    "help": "tsx src/run.ts help",
    "preflight": "tsx src/run.ts preflight",
    "verify-judge": "tsx src/run.ts verify-judge",
    "batch-compare": "tsx src/run.ts batch-compare",
    "gate": "tsx src/corpus-replay.mts corpus/finsearch.jsonl --selector",
    "keystone-gate": "tsx src/keystone-gate-cli.mts",
    "gate-report": "tsx src/corpus-report.mts corpus/finsearch.jsonl",
    "gepa-refine": "tsx src/gepa-refine.ts",
    "terminal-compare": "tsx src/terminal-compare.ts"
  },
  "dependencies": {
    "@tangle-network/agent-eval": "^0.76.0",
    "@tangle-network/agent-runtime": "file:..",
    "@tangle-network/sandbox": "^0.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
